# Postgres connection. Locally: docker compose up -d (see root docker-compose.yml).
# Production (Neon): use the pooled connection string here.
DATABASE_URL="postgresql://buffet:buffet@localhost:5432/buffet"
# Used only by `npm test`
TEST_DATABASE_URL="postgresql://buffet:buffet@localhost:5432/buffet_test"

# Long random strings. Generate with: openssl rand -base64 32
SESSION_SECRET=""
QR_SECRET=""

# First owner account, created by `npx prisma db seed` if it doesn't exist
SEED_OWNER_NAME="Owner"
SEED_OWNER_USERNAME="owner"
SEED_OWNER_PASSWORD=""

# Timezone used for "today" stats
TZ="Asia/Kolkata"
PORT=3001
